    "from kaggle_secrets import UserSecretsClient\n",
    "secrets = UserSecretsClient()\n",
    "GITHUB_TOKEN = secrets.get_secret(\"GITHUB_TOKEN\")\n",
    "HF_TOKEN = secrets.get_secret(\"HF_TOKEN\")\n",
    "\n",
    "import os\n",
    "os.environ[\"HF_TOKEN\"] = HF_TOKEN\n",
    "\n",
    "import os\n",
    "if os.path.isdir(\"repo\"):\n",
    "    # repo already checked out in this kernel (e.g. cell re-run) -- refresh\n",
    "    # it instead of letting `git clone` fail and silently leaving stale code\n",
    "    # that the train.py patch below wouldn't correctly apply to\n",
    "    print(\"repo/ already exists -- refreshing to a clean phase2 checkout\")\n",
    "    !cd repo && git fetch origin phase2 && git checkout phase2 && git reset --hard origin/phase2\n",
    "else:\n",
    "    !git clone -b phase2 https://{GITHUB_TOKEN}@github.com/CL3-410/individual-project-ManyaJain111.git repo"
   ]
