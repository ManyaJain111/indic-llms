   "source": [
    "import random\n",
    "\n",
    "SPLIT_DIR = f'{OUT_DIR}/nepali_resplit'\n",
    "os.makedirs(SPLIT_DIR, exist_ok=True)\n",
    "\n",
    "SEED      = 42\n",
    "VAL_FRAC  = 0.02   # ~2% of unique lines held out for val\n",
    "TEST_FRAC = 0.02   # ~2% of unique lines held out for test\n",
    "\n",
    "def find_file(fname):\n",
    "    matches = glob.glob(f'{EXTRACT_DIR}/**/{fname}', recursive=True)\n",
    "    return matches[0] if matches else None\n",
    "\n",
    "# 1. Pool every line from all three original splits, deduping exactly\n",
    "seen = set()\n",
    "pooled = []\n",
    "for fname in ['train.txt', 'val.txt', 'test.txt']:\n",
    "    fpath = find_file(fname)\n",
    "    if not fpath:\n",
    "        print(f'\\u26a0\\ufe0f {fname} not found, skipping')\n",
    "        continue\n",
    "    n_before = n_kept = 0\n",
    "    with open(fpath, encoding='utf-8', errors='ignore') as f:\n",
    "        for line in f:\n",
    "            n_before += 1\n",
    "            line = line.strip()\n",
    "            if not line or line in seen:\n",
    "                continue\n",
    "            seen.add(line)\n",
    "            pooled.append(line)\n",
    "            n_kept += 1\n",
    "    print(f'{fname}: {n_before:,} lines -> {n_kept:,} new unique lines (running total {len(pooled):,})')\n",
    "    # free disk space immediately -- these lines are already safely in\n",
    "    # `pooled` in memory, and the resplit files below would otherwise sit\n",
    "    # on disk alongside a near-full second copy of the original corpus,\n",
    "    # which is what caused the previous 'No space left on device' error\n",
    "    os.remove(fpath)\n",
    "    print(f'  (freed disk space -- removed original {fpath})')\n",
    "\n",
    "print(f'\\nTotal unique lines after pooling all three splits: {len(pooled):,}')\n",
    "del seen\n",
    "\n",
    "# 2. Reshuffle once, deterministically\n",
    "random.Random(SEED).shuffle(pooled)\n",
    "\n",
    "# 3. Carve off val/test first (small, fixed-size, disjoint from train by construction)\n",
    "n_val  = int(len(pooled) * VAL_FRAC)\n",
    "n_test = int(len(pooled) * TEST_FRAC)\n",
    "val_lines   = pooled[:n_val]\n",
    "test_lines  = pooled[n_val:n_val + n_test]\n",
    "train_lines = pooled[n_val + n_test:]  # rest goes to train; tokenize_to_file below still caps it at MAX_TRAIN tokens\n",
    "\n",
    "print(f'New split -> train: {len(train_lines):,} lines | val: {len(val_lines):,} | test: {len(test_lines):,}')\n",
    "\n",
    "for name, lines in [('train', train_lines), ('val', val_lines), ('test', test_lines)]:\n",
    "    # write line-by-line rather than building one giant joined string,\n",
    "    # to avoid a second full-corpus-sized string sitting in memory too\n",
    "    with open(f'{SPLIT_DIR}/{name}.txt', 'w', encoding='utf-8') as f:\n",
    "        for line in lines:\n",
    "            f.write(line + '\\n')\n",
    "print(f'\\u2705 Wrote deduped, disjoint splits to {SPLIT_DIR}')\n"
   ]
  },
