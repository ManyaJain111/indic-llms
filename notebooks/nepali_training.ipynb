    "def load_lines(fname):\n",
    "    path = glob.glob(f'{EXTRACT_DIR}/**/{fname}', recursive=True)[0]\n",
    "    with open(path, encoding='utf-8', errors='ignore') as f:\n",
    "        lines = set(line.rstrip('\\n') for line in f)\n",
    "    print(f\"{fname}: {len(lines):,} unique lines\")\n",
    "    return lines\n",
    "\n",
    "_train_lines = load_lines('train.txt')\n",
    "_val_lines   = load_lines('val.txt')\n",
    "_test_lines  = load_lines('test.txt')\n",
    "\n",
    "print(\"train \\u2229 val:\", len(_train_lines & _val_lines), f\"({100*len(_train_lines & _val_lines)/len(_val_lines):.1f}% of val)\")\n",
    "print(\"train \\u2229 test:\", len(_train_lines & _test_lines), f\"({100*len(_train_lines & _test_lines)/len(_test_lines):.1f}% of test)\")\n",
    "print(\"val \\u2229 test:\", len(_val_lines & _test_lines))\n",
    "del _train_lines, _val_lines, _test_lines\n"
   ]
