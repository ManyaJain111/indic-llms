   "source": [
    "import os, json, re, string, glob, tarfile, numpy as np\n",
    "from multiprocessing import Pool, cpu_count\n",
    "from huggingface_hub import hf_hub_download\n",
    "\n",
    "EXTRACT_DIR = '/kaggle/working/lma_extracted/nepali-lma-corpus'\n",
    "TOK_PATH    = 'repo/phase2/tokenizers/nepali_tokenizer_16000.json'\n",
    "OUT_DIR     = '/kaggle/working'\n",
    "MAX_TRAIN   = 500_000_000  # hard cap requested: 500M train tokens\n",
    "CHUNK       = 5000\n",
    "\n",
    "def _required_split_files_present(extract_dir):\n",
    "    # cell 12 (dedup) deletes train.txt/val.txt/test.txt from EXTRACT_DIR\n",
    "    # after pooling them, by design -- so a leftover .done marker from an\n",
    "    # earlier pass through this notebook does NOT mean the raw files are\n",
    "    # still here. Check for the files themselves, not just the marker.\n",
    "    return all(glob.glob(f'{extract_dir}/**/{fname}', recursive=True)\n",
    "               for fname in ('train.txt', 'val.txt', 'test.txt'))\n",
    "\n",
    "if os.path.exists(f'{EXTRACT_DIR}/.done') and not _required_split_files_present(EXTRACT_DIR):\n",
    "    print(f\"[Dataset] {EXTRACT_DIR}/.done exists but train/val/test.txt are missing \"\n",
    "          f\"(likely deleted by the dedup cell in an earlier run) -- re-extracting.\")\n",
    "    os.remove(f'{EXTRACT_DIR}/.done')\n",
    "\n",
    "if not os.path.exists(f'{EXTRACT_DIR}/.done'):\n",
    "    print(\"[Dataset] Downloading nepali_submission_phase1.tar.gz...\")\n",
    "    tar_path = hf_hub_download(repo_id=\"manyajain111/nepali-lma-corpus\", filename=\"nepali_submission_phase1.tar.gz\", repo_type=\"dataset\")\n",
    "    os.makedirs(EXTRACT_DIR, exist_ok=True)\n",
    "    with tarfile.open(tar_path, \"r:gz\") as tar:\n",
    "        tar.extractall(path=EXTRACT_DIR)\n",
    "    open(f'{EXTRACT_DIR}/.done', 'w').close()\n",
    "    print(\"[Dataset] Extraction done!\")\n",
    "else:\n",
    "    print(f\"[Dataset] Already extracted in {EXTRACT_DIR}\")\n",
    "\n",
    "PUNCT    = re.escape(string.punctuation + \"।॥''\\\"\\\"\")\n",
    "WORD_PAT = re.compile(rf\" ?[^{PUNCT}\\s]+| ?[{PUNCT}]+\", re.UNICODE)\n",
    "_vocab = _merge_ranks = _b2c = _cache = _mode = None\n",
    "\n",
    "def detect_bpe_mode(vocab):\n",
    "    \"\"\"\n",
    "    Two training regimes produce a tokenizer json with the same\n",
    "    'vocab'/'merges' shape on disk, but they are NOT interchangeable:\n",
    "      - byte-level BPE (Hindi): base alphabet = the 256 raw UTF-8 bytes,\n",
    "        remapped 1:1 to chr(0..255) before merges are learned.\n",
    "      - char-level BPE (Nepali, per Phase-1 report): base alphabet =\n",
    "        actual Unicode codepoints, with merges learned directly over them.\n",
    "    Feeding a char-level tokenizer's merge table a byte-decomposed input\n",
    "    (or vice versa) means the merge lookup never matches, BPE breaks\n",
    "    immediately for every word, and encoding silently degrades to\n",
    "    ~1 token per UTF-8 byte -- ~3x inflation for 3-byte Devanagari on top\n",
    "    of losing all subword compression.\n",
    "    Detect by checking whether any vocab entry contains a Devanagari\n",
    "    codepoint (U+0900-U+097F) directly: byte-remapped entries can't,\n",
    "    since chr(0..255) only spans Latin-1.\n",
    "    \"\"\"\n",
    "    for tok in vocab:\n",
    "        if any(0x0900 <= ord(ch) <= 0x097F for ch in tok):\n",
    "            return 'char'\n",
    "    return 'byte'\n",
    "\n",
    "def init_worker(tok_path):\n",
    "    global _vocab, _merge_ranks, _b2c, _cache, _mode\n",
    "    with open(tok_path) as f: data = json.load(f)\n",
    "    _vocab = data['vocab']\n",
    "    merges = [((a, b), a + b) for a, b in data['merges']]\n",
    "    _merge_ranks = {p: i for i, (p, _) in enumerate(merges)}\n",
    "    _b2c = {i: chr(i) for i in range(256)}\n",
    "    _mode = detect_bpe_mode(_vocab)\n",
    "    _cache = {}\n",
    "\n",
    "def _base_symbols(w):\n",
    "    # byte-level tokenizer -> decompose to raw UTF-8 bytes (remapped to chr(0..255))\n",
    "    # char-level tokenizer -> use the actual Unicode codepoints directly\n",
    "    if _mode == 'byte':\n",
    "        return [_b2c[b] for b in w.encode('utf-8')]\n",
    "    return list(w)\n",
    "\n",
    "def encode_chunk(lines):\n",
    "    out = []\n",
    "    for line in lines:\n",
    "        line = line.strip()\n",
    "        if not line: continue\n",
    "        for w in WORD_PAT.findall(line):\n",
    "            if w not in _cache:\n",
    "                s = _base_symbols(w)\n",
    "                while len(s) > 1:\n",
    "                    pairs  = [(s[i], s[i+1]) for i in range(len(s)-1)]\n",
    "                    ranked = [(_merge_ranks[p], i) for i, p in enumerate(pairs) if p in _merge_ranks]\n",
    "                    if not ranked: break\n",
    "                    _, i = min(ranked)\n",
    "                    s = s[:i] + [s[i] + s[i+1]] + s[i+2:]\n",
    "                _cache[w] = [_vocab.get(x, 0) for x in s]\n",
    "            out.extend(_cache[w])\n",
    "    return out\n",
    "\n",
    "def tokenize_to_file(fnames, out_path, max_tok=None, base_dir=None):\n",
    "    import time\n",
    "    base_dir = base_dir or EXTRACT_DIR\n",
    "    fpaths = []\n",
    "    for f in fnames:\n",
    "        matches = glob.glob(f'{base_dir}/**/{f}', recursive=True)\n",
    "        if matches: fpaths.append(matches[0])\n",
    "    if not fpaths:\n",
    "        print(f\"❌ Error: Could not find any of {fnames} in {EXTRACT_DIR}\")\n",
    "        return\n",
    "    if os.path.exists(out_path): os.remove(out_path)\n",
    "    total_tokens = 0\n",
    "    t0 = time.time()\n",
    "    with open(out_path, 'wb') as f_out:\n",
    "        for fpath in fpaths:\n",
    "            print(f'Reading {os.path.basename(fpath)}...')\n",
    "            lines = open(fpath, encoding='utf-8', errors='ignore').readlines()\n",
    "            print(f'  {len(lines):,} lines | {cpu_count()} CPUs')\n",
    "            chunks = [lines[i:i+CHUNK] for i in range(0, len(lines), CHUNK)]\n",
    "            with Pool(cpu_count(), initializer=init_worker, initargs=(TOK_PATH,)) as pool:\n",
    "                for i, r in enumerate(pool.imap(encode_chunk, chunks)):\n",
    "                    arr = np.array(r, dtype=np.uint16)\n",
    "                    f_out.write(arr.tobytes())\n",
    "                    total_tokens += len(arr)\n",
    "                    if i % 20 == 0:\n",
    "                        tps = total_tokens / max(time.time() - t0, 1)\n",
    "                        print(f'  {i}/{len(chunks)} chunks | {total_tokens:,} tokens | {tps:,.0f} tok/s', flush=True)\n",
    "                    if max_tok and total_tokens >= max_tok:\n",
    "                        pool.terminate()\n",
    "                        break\n",
    "            if max_tok and total_tokens >= max_tok: break\n",
    "    print(f'✅ Saved {total_tokens:,} tokens -> {out_path}\\n')\n"
   ]
  },
