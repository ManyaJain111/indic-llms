   "source": [
    "# --- Sanity check: confirm the tokenizer's BPE mode before burning another\n",
    "# 40+ chunk run. This encodes a small sample of the deduped train split and\n",
    "# compares the resulting fertility (tokens/word) against the Phase-1\n",
    "# report's 1.2059 -- if detect_bpe_mode() had guessed wrong, this would\n",
    "# still show ~3x inflation; if it's now right, fertility should land close\n",
    "# to the report's number.\n",
    "with open(TOK_PATH) as f:\n",
    "    _tok_data = json.load(f)\n",
    "_detected_mode = detect_bpe_mode(_tok_data['vocab'])\n",
    "print(f\"Detected BPE base-alphabet mode for {TOK_PATH}: '{_detected_mode}'\")\n",
    "print(\"(byte-level = raw UTF-8 bytes remapped to chr(0..255); \"\n",
    "      \"char-level = raw Unicode codepoints)\")\n",
    "\n",
    "init_worker(TOK_PATH)\n",
    "with open(f'{SPLIT_DIR}/train.txt', encoding='utf-8') as f:\n",
    "    _sample_lines = [next(f) for _ in range(200)]\n",
    "_sample_tokens = encode_chunk(_sample_lines)\n",
    "_sample_words = sum(len(WORD_PAT.findall(l.strip())) for l in _sample_lines if l.strip())\n",
    "_fertility = len(_sample_tokens) / _sample_words\n",
    "\n",
    "print(f\"Sample: {len(_sample_lines)} lines | {_sample_words} words | {len(_sample_tokens)} tokens\")\n",
    "print(f\"Fertility (tokens/word): {_fertility:.4f}  <- compare to Phase-1 report's 1.2059\")\n",
    "\n",
    "if _fertility > 2.0:\n",
    "    print(\"\\n\\u26a0\\ufe0f Still way above 1.2 -- detect_bpe_mode() likely guessed wrong, \"\n",
    "          \"or the merge table itself doesn't match either hypothesis. \"\n",
    "          \"STOP and inspect nepali_tokenizer_16000.json's 'vocab'/'merges' \"\n",
    "          \"structure directly before re-running tokenize_to_file.\")\n",
    "else:\n",
    "    print(\"\\n\\u2705 Fertility is in the expected range -- safe to proceed to tokenize_to_file below.\")\n"
   ]
  },
