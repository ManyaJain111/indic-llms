   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ℹ️ final-save already includes optimizer/scheduler state — skipping (idempotent)\n",
      "✅ train.py patch complete\n"
     ]
    }
   ],
   "source": [
    "train_py_path = \"repo/phase2/src/train.py\"\n",
    "with open(train_py_path) as f:\n",
    "    src = f.read()\n",
    "\n",
    "# Fix final-save to include optimizer/scheduler state (needed to resume\n",
    "# later if this run gets interrupted)\n",
    "old_final_save = '''    torch.save({\n",
    "        'step': step,\n",
    "        'model_state_dict': get_model_state_dict(model),\n",
    "        'config': config\n",
    "    }, os.path.join(args.output_dir, \"model_final.pt\"))'''\n",
    "new_final_save = '''    torch.save({\n",
    "        'step': step,\n",
    "        'model_state_dict': get_model_state_dict(model),\n",
    "        'optimizer_state_dict': optimizer.state_dict(),\n",
    "        'scheduler_state_dict': scheduler.state_dict(),\n",
    "        'config': config\n",
    "    }, os.path.join(args.output_dir, \"model_final.pt\"))'''\n",
    "if \"'optimizer_state_dict': optimizer.state_dict()\" in src:\n",
    "    print(\"ℹ️ final-save already includes optimizer/scheduler state — skipping (idempotent)\")\n",
    "elif old_final_save in src:\n",
    "    src = src.replace(old_final_save, new_final_save)\n",
    "else:\n",
    "    print(\"⚠️ final save block not found — may already be patched, or repo changed\")\n",
    "\n",
    "with open(train_py_path, \"w\") as f:\n",
    "    f.write(src)\n",
    "\n",
    "print(\"✅ train.py patch complete\")\n"
   ]
  },
